# Use powerline
USE_POWERLINE="true"
# Has weird character width
# Example:
#    is not a diamond
HAS_WIDECHARS="false"
# Source manjaro-zsh-configuration
if [[ -e /usr/share/zsh/manjaro-zsh-config ]]; then
  source /usr/share/zsh/manjaro-zsh-config
fi

# Kill the "correct 'pip' to '_pip' [nyae]?" prompt. /usr/share/zsh/manjaro-zsh-config
# line 2 does `setopt correct`; that file is package-owned and gets replaced on
# update, so it is undone here instead of edited there. Must come after the source
# above. correctall is not set by Manjaro, but is unset too in case that changes.
unsetopt correct
unsetopt correctall

# Use manjaro zsh prompt
PROMPT='%F{red}Δ%f '
RPROMPT=''

# dex = the trading repo CLI (shadows /usr/bin/dex in interactive shells only,
# so sway autostart still gets the real DesktopEntry tool). runs whichever
# checkout you're inside (~/dex, ~/dex2, ~/dex3, ...) with its own venv,
# falling back to ~/dex from anywhere else
dex() {
    local root="$PWD"
    while [[ "$root" != "/" && ! -f "$root/py/main.py" ]]; do root="${root:h}"; done
    [[ -f "$root/py/main.py" ]] || root="$HOME/dex"
    local venv="$root/.venv"
    [[ -d "$venv" ]] || venv="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)/../.venv"
    "$venv/bin/python" "$root/py/main.py" "$@"
}
export PATH="$HOME/.cargo/bin:$PATH"
