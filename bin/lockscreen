#!/bin/sh
# Lock the session, with the fan ARGB ring dark while locked.
# gtklock runs in the foreground (no -d) so this script knows when unlock
# happens and can restore the blue. Needs the NOPASSWD sudoers rule for
# framework_tool --rgbkbd; -n + || true so a missing rule never blocks locking.

# ext-session-lock allows one locker; if idle-lock fires while already locked,
# a second gtklock would exit instantly and wrongly restore blue mid-lock.
pgrep -x gtklock >/dev/null && exit 0

OFF="0x000000"
BLUE="0x1793D1"

sudo -n /usr/bin/framework_tool --rgbkbd 0 $OFF $OFF $OFF $OFF $OFF $OFF $OFF $OFF >/dev/null 2>&1 || true

GDK_BACKEND=wayland gtklock -M HDMI-A-1 -s /home/andy/.config/gtklock/style.css

sudo -n /usr/bin/framework_tool --rgbkbd 0 $BLUE $BLUE $BLUE $BLUE $BLUE $BLUE $BLUE $BLUE >/dev/null 2>&1 || true
